FROM mediawiki:1.46-fpm-alpine AS mediawiki
ENV MEDIAWIKI_BRANCH REL1_46

COPY --from=composer /usr/bin/composer /usr/bin/composer
COPY ./config/supervisord/supervisord.conf /etc/
COPY ./config/php/php-config.ini /usr/local/etc/php/conf.d/php-config.ini
# Filename must sort after www.conf and zz-docker.conf: FPM includes
# php-fpm.d/*.conf alphabetically and later files win, so anything www.conf
# declares actively (the whole pm.* block) would otherwise override us.
COPY ./config/php/zzz-pool-overrides.conf /usr/local/etc/php-fpm.d/zzz-pool-overrides.conf

RUN apk add --no-cache pcre-dev ghostscript imagemagick imagemagick-dev poppler-utils nodejs npm nginx supervisor lua5.1 lua5.1-dev vips-dev vips-tools libwebp-tools rsvg-convert gmp-dev $PHPIZE_DEPS \
    && pecl install redis luasandbox \
    && docker-php-ext-install exif gmp \
    && docker-php-ext-enable redis.so luasandbox

RUN set -eux; \
	# Install wikidiff2
	# No pecl package for wikidiff2 (https://phabricator.wikimedia.org/T196132)
	curl -sSLf \
		-o /usr/local/bin/install-php-extensions \
		https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions && \
		chmod +x /usr/local/bin/install-php-extensions && \
		install-php-extensions wikidiff2 \
	;

RUN mkdir /tmp/www && \
    mv /var/www/html/* /tmp/www && \
    mkdir /var/www/html/w && \
    mv /tmp/www/* /var/www/html/w

RUN chown -R www-data:www-data /var/www/html && \
    chown -R www-data:www-data /run && \
    chown -R www-data:www-data /var/lib/nginx && \
    chown -R www-data:www-data /var/log/nginx

USER www-data
WORKDIR /var/www/html/w/

# Mediawiki linked version extensions
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-AdvancedSearch.git" extensions/AdvancedSearch
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-Babel.git" extensions/Babel
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-CirrusSearch.git" extensions/CirrusSearch
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-Citoid.git" extensions/Citoid
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-CodeMirror.git" extensions/CodeMirror
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-CommonsMetadata.git" extensions/CommonsMetadata
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-Disambiguator.git" extensions/Disambiguator
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-DismissableSiteNotice.git" extensions/DismissableSiteNotice
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-Elastica.git" extensions/Elastica
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-EventBus.git" extensions/EventBus
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-GeoData.git" extensions/GeoData
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-LabeledSectionTransclusion.git" extensions/LabeledSectionTransclusion
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-Loops.git" extensions/Loops
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-MediaSearch.git" extensions/MediaSearch
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-MyVariables.git" extensions/MyVariables
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-NearbyPages.git" extensions/NearbyPages
# RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-OAuth.git" extensions/OAuth
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-Popups.git" extensions/Popups
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-RelatedArticles.git" extensions/RelatedArticles
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-RevisionSlider.git" extensions/RevisionSlider
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-SandboxLink.git" extensions/SandboxLink
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-TwoColConflict.git" extensions/TwoColConflict
RUN git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-Variables.git" extensions/Variables
# Thanks is bundled in the tarball, which is still 1.46.0, so swap in REL1_46 for
# CVE-2026-100237 (stored XSS, fixed in 1.46.1). Harmless to keep once the base
# image moves on: it then tracks the branch like the extensions above.
RUN rm -rf extensions/Thanks && \
    git clone --depth 1 -b $MEDIAWIKI_BRANCH "https://github.com/wikimedia/mediawiki-extensions-Thanks.git" extensions/Thanks

# Hotfix: CVE-2026-96873, reflected XSS in CirrusSearch's ExplainPrinter
# (T435234). Fixed on master only, not yet backported to REL1_46. Drop when it
# is: the build will fail here once the patch no longer applies.
# See includes/CirrusSearch/explainprinter-xss.patch.
COPY ./includes/CirrusSearch/explainprinter-xss.patch /tmp/explainprinter-xss.patch
RUN git -C extensions/CirrusSearch apply /tmp/explainprinter-xss.patch

# Separate version extensions
RUN git clone --depth 1 -b v0.14.0 "https://github.com/edwardspec/mediawiki-aws-s3.git" extensions/AWS
RUN git clone --depth 1 -b 3.9.4 "https://github.com/wikimedia/mediawiki-extensions-Cargo.git" extensions/Cargo
RUN git clone --depth 1 -b 1.3 "https://github.com/chariz/mediawiki-extensions-Details.git" extensions/Details
RUN git clone --depth 1 -b 4.0.6 "https://github.com/Universal-Omega/DynamicPageList4.git" extensions/DynamicPageList4
RUN git clone --depth 1 -b v4.2.0 "https://github.com/StarCitizenWiki/mediawiki-extensions-EmbedVideo.git" extensions/EmbedVideo
RUN git clone --depth 1 -b main "https://github.com/miraheze/MatomoAnalytics.git" extensions/MatomoAnalytics
RUN git clone --depth 1 -b v2.0.0 "https://github.com/octfx/mediawiki-extensions-MultiPurge.git" extensions/MultiPurge
RUN git clone --depth 1 -b main "https://github.com/weirdgloop/mediawiki-extensions-SearchDigest.git" extensions/SearchDigest
# Hotfix: SearchDigest's schema files hardcode bare table names, so on a wiki with
# $wgDBprefix the updater creates `searchdigest`/`searchdigest_blocks` while every
# runtime query asks for `mw_searchdigest`. Rewrite them to the /*_*/ placeholder
# that Database::sourceFile() expands to the prefix. Drop when upstream fixes it.
# See includes/SearchDigest/db-table-prefix.patch.
COPY ./includes/SearchDigest/db-table-prefix.patch /tmp/searchdigest-db-table-prefix.patch
RUN git -C extensions/SearchDigest apply /tmp/searchdigest-db-table-prefix.patch

RUN git clone --depth 1 -b main "https://github.com/StarCitizenTools/mediawiki-extensions-ShortDescription.git" extensions/ShortDescription
RUN git clone --depth 1 -b v4.1.0 "https://github.com/StarCitizenTools/mediawiki-extensions-TabberNeue.git" extensions/TabberNeue
RUN git clone --depth 1 -b v3.0.0 "https://github.com/octfx/mediawiki-extensions-TemplateStylesExtender.git" extensions/TemplateStylesExtender
RUN git clone --depth 1 -b v2.1.1 "https://github.com/StarCitizenTools/mediawiki-extensions-Thumbro.git" extensions/Thumbro
# Hotfix: teach Thumbro's libvips-scaled handlers to answer action=imagerotate.
# Upstream v2.0.1 leaves rotate() to core BitmapHandler, which has no libvips
# branch, so imagerotate fails with "libvips rotation not implemented". Drop when
# a fixed Thumbro release lands. See includes/Thumbro/imagerotate-libvips.patch.
COPY ./includes/Thumbro/imagerotate-libvips.patch /tmp/imagerotate-libvips.patch
RUN git -C extensions/Thumbro apply /tmp/imagerotate-libvips.patch

# Separate version skins
RUN git clone --depth 1 -b v3.24.0 "https://github.com/StarCitizenTools/mediawiki-skins-Citizen.git" skins/Citizen

COPY ./composer.json /var/www/html/w/composer.local.json
# Composer refuses packages with known security advisories; keep that on.
# - Guzzle: the base image's 1.46 tarball pins 7.12.3, which has open advisories
#   (CVE-2026-69246 and others). REL1_46 upstream already pins 7.15.2, so match
#   it. Drop this once the mediawiki:1.46-fpm-alpine image ships 7.15.2 or later.
# - PHP_CodeSniffer: dev-only, never installed, but still resolved; ignored as
#   in the jobrunner stage.
RUN composer require --no-update --no-interaction guzzlehttp/guzzle:7.15.2 && \
    composer config --no-plugins --json policy.advisories.ignore '["squizlabs/php_codesniffer"]' && \
    composer update --no-dev --no-interaction --no-scripts --ignore-platform-reqs --verbose

# Hotfix: MediaHandlerFactory::getHandler() caches handler instances by mimetype,
# so the $lang of the *first* caller sticks and every later call gets a handler
# set to the wrong language. Breaks search result snippets and file page rendering.
# Merged upstream to REL1_46 as I7749f261 (T425988, T425740, T425782, T431182) but
# not yet in a 1.46.x tarball, so the base image still ships the bug. Drop this once
# the mediawiki:1.46-fpm-alpine image carries the fix — the build will fail here
# when it does, because the patch will no longer apply.
COPY ./includes/core/mediahandlerfactory-language-cache.patch /tmp/mediahandlerfactory-language-cache.patch
RUN git apply --verbose /tmp/mediahandlerfactory-language-cache.patch

COPY ./includes/favicon.ico /var/www/html/favicon.ico
COPY ./includes/robots.txt /var/www/html/robots.txt

USER root
RUN chown -R root:root /var/www/html && \
    chmod -R u=rwX,go=rX /var/www/html && \
    # $wgCacheDirectory. Mounted as a volume, which takes this owner on creation.
    install -d -o www-data -g www-data /var/cache/mediawiki
USER www-data

# Prebuild the English localisation cache into $wgCacheDirectory. Docker seeds a
# new volume from the image's contents, so each deploy's fresh cache volume
# (compose up -V) starts with English ready, instead of every PHP worker
# rebuilding it at once on the first page views. Other languages still build on
# first use. Built from the LocalSettings.php the containers mount, which needs
# neither the database nor any secret to load, only the database name for the
# wiki ID it works out at load time (as in docker-compose.yml). No message purge
# here, as there is no cache to purge: deploy.yml runs purgeMessageBlobStore
# once the new containers are up.
RUN --mount=type=bind,source=config/mediawiki/LocalSettings.php,target=/var/www/html/w/LocalSettings.php \
    MYSQL_DATABASE=coasterpedia \
    php maintenance/run.php rebuildLocalisationCache --lang=en --no-database --skip-message-purge --no-progress

# Exec form, so supervisord gets the stop signal itself rather than through a shell.
ENTRYPOINT ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

FROM mediawiki AS jobrunner
USER root

RUN docker-php-ext-configure pcntl --enable-pcntl \
  && docker-php-ext-install pcntl

WORKDIR /var/www/html/w/

RUN git clone --depth 1 "https://github.com/wikimedia/mediawiki-services-jobrunner.git" mediawiki-services-jobrunner

RUN set -eux; \
   cd mediawiki-services-jobrunner; \
   export COMPOSER_ALLOW_SUPERUSER=1; \
   /usr/bin/composer config --no-plugins allow-plugins.composer/installers true; \
   /usr/bin/composer config --no-plugins --json policy.advisories.ignore '["squizlabs/php_codesniffer"]'; \
   /usr/bin/composer install --no-dev \
     --ignore-platform-reqs \
     --no-ansi \
     --no-interaction \
     --no-scripts; \
   chmod -R u=rwX,go=rX /var/www/html/w/mediawiki-services-jobrunner

COPY --chmod=644 ./config/jobrunner/jobrunner-conf.json /var/www/html/w/mediawiki-services-jobrunner
COPY --chmod=755 ./config/jobrunner/entrypoint.sh /var/www/html/w/mediawiki-services-jobrunner

USER www-data

ENTRYPOINT [ "/var/www/html/w/mediawiki-services-jobrunner/entrypoint.sh" ]