[mariadbd]
log_bin                         = mariadb-bin
server_id                       = 1
binlog_format                   = ROW
expire_logs_days                = 7
sync_binlog                     = 1
innodb_flush_log_at_trx_commit  = 1
innodb_snapshot_isolation       = OFF
innodb_buffer_pool_size         = 4G
key_buffer_size                 = 1M
tmp_table_size                  = 64M
max_heap_table_size             = 64M
innodb_log_file_size            = 240M
innodb_log_buffer_size          = 24M